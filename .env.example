# AI Gerpro — configuração do backend.
# Copie para backend/.env e ajuste. Nunca versione o arquivo .env.

# --- Identificação técnica do ambiente ---
# Este projeto é um AMBIENTE DE DEMONSTRAÇÃO: sem dados reais. Sem as variáveis de recuperação
# abaixo, o assistente usa somente o Ollama (nenhuma base corporativa é consultada).
# O valor aparece no diagnóstico interno (GET /api/health/details) e nos logs; NÃO no título do assistente.
#
# MODO CORPORATIVO (Etapa 4.1): qualquer valor FORA de demo, dev, development, local e test (ex.: homologacao,
# producao) ativa regras estritas, validadas na inicialização (o backend não sobe se faltar algo):
#   - chat só com autenticação (CHAT_REQUIRE_AUTH=true; exige GERPRO_AUTH_MODE=jwt-hs256 ou resolvedor próprio);
#   - JWT com GERPRO_AUTH_JWT_ISSUER e GERPRO_AUTH_JWT_AUDIENCE;
#   - Neo4j sem +ssc e sem *_ALLOW_INSECURE=true;
#   - diagnóstico interno só com DIAGNOSTICS_TOKEN (loopback desativado por padrão).
APP_ENV=demo

# Nível de log do Fastify (fatal, error, warn, info, debug, trace). Logs nunca incluem perguntas,
# trechos recuperados, tokens ou senhas.
LOG_LEVEL=info

# --- Servidor backend ---
PORT=3001
# 127.0.0.1 = só a própria máquina (proxy reverso no mesmo servidor). Use o IP interno ou 0.0.0.0 apenas se o
# proxy estiver em outra máquina, e restrinja a porta no firewall a esse proxy.
HOST=127.0.0.1
# Origem permitida para CORS (apenas se o frontend/widget NÃO usar o proxy do Vite,
# por exemplo ao embutir o widget numa página servida por outra origem)
CORS_ORIGIN=http://localhost:5173

# --- Ollama (acessado somente pelo backend) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo padrão (Etapa 2.1): Qwen3 4B Instruct, sem raciocínio obrigatório (1º token em ~40 ms).
# Alternativa instalada: qwen3:4b (variante "thinking": mais lenta, ~7–30 s por resposta).
# Comparação completa: docs/BENCHMARK-MODELOS.md
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_MODEL=qwen3:4b
# Tempo máximo por resposta (ms), incluindo o eventual tempo de raciocínio do modelo.
OLLAMA_TIMEOUT_MS=120000
# MANTENHA "auto" (preserva o streaming com os dois modelos instalados).
# auto  = consulta as capacidades do modelo; se declarar "thinking", o Ollama separa o raciocínio
#         (descartado pelo backend). Funciona com o instruct (não raciocina) e com o qwen3:4b.
# true  = sempre pede a separação (erro em modelos sem a capacidade "thinking").
# false = não pede. Com os dois modelos instalados (ambos declaram "thinking"), o backend retém
#         o texto até o fim da resposta: PERDE o streaming, sem ganho de tempo.
OLLAMA_THINK=auto
# Mantém o modelo carregado na GPU entre perguntas (evita ~2,5 s de carga). "default" = padrão do Ollama (5m).
OLLAMA_KEEP_ALIVE=30m
# Janela de contexto. 8192 comporta histórico longo (e os ~1.800 tokens de raciocínio, se usar qwen3:4b).
# 0 = padrão do Ollama.
OLLAMA_NUM_CTX=8192
# Carrega o modelo ao iniciar o backend, para a 1ª pergunta não esperar a carga.
OLLAMA_PRELOAD=true

# --- Limites do chat ---
# O widget lê estes limites em GET /api/health e envia só as últimas mensagens que cabem neles
# (a conversa visível continua inteira). Mantenha CHAT_MAX_MESSAGES >= 2 x RETRIEVAL_CONTEXT_TURNS + 1.
CHAT_MAX_MESSAGES=30
CHAT_MAX_CHARS_PER_MESSAGE=8000

# --- Proteção do backend (Etapa 4.1) ---
# Exige o token do Gerpro (Authorization: Bearer) para usar o chat: nada chega à GPU sem autenticação.
# Padrão: false nos ambientes locais; true (e obrigatório) em modo corporativo.
# CHAT_REQUIRE_AUTH=false
# Diagnóstico interno GET /api/health/details (estado de Ollama, Qdrant, Neo4j, embeddings, avisos).
# Token administrativo próprio (>= 32 bytes, diferente do segredo JWT), enviado em Authorization: Bearer.
# DIAGNOSTICS_TOKEN=
# Permite o diagnóstico sem token em conexões diretas de 127.0.0.1/::1 SEM cabeçalhos de proxy.
# Padrão: true nos ambientes locais; false em modo corporativo.
# DIAGNOSTICS_ALLOW_LOOPBACK=true

# =====================================================================================
# Recuperação nas bases corporativas (Etapa 3.1) — TUDO OPCIONAL.
# Sem estas variáveis o assistente funciona normalmente, somente com o Ollama.
# Guia completo: docs/INTEGRACAO-RECUPERACAO.md
# Segredos (API key, senha, segredo JWT) ficam SÓ aqui, no backend: nunca no frontend,
# no arquivo de mapeamento, em URLs ou em logs.
# =====================================================================================

# --- Mapeamento (coleções, campos e consultas Cypher autorizadas; sem segredos) ---
# Modelo: backend/retrieval.config.example.json (copie, renomeie e preencha com os nomes reais).
# RETRIEVAL_CONFIG_PATH=retrieval.config.json
# Tempo máximo da recuperação por pergunta; o que não chegar a tempo é ignorado.
# RETRIEVAL_TIMEOUT_MS=8000
# RETRIEVAL_MAX_SOURCES=8
# Orçamento de contexto enviado ao modelo (caracteres). Lembre de OLLAMA_NUM_CTX.
# RETRIEVAL_MAX_CONTEXT_CHARS=6000
# RETRIEVAL_MAX_CHARS_PER_SOURCE=1500
# Perguntas de continuação ("quem é o responsável por ele?"): quantas mensagens ANTERIORES do
# usuário examinar em busca do identificador (só texto digitado pelo usuário). 0 = desativa.
# RETRIEVAL_CONTEXT_TURNS=4

# --- Qdrant (somente leitura; nunca cria/altera/exclui coleções) ---
# https:// é obrigatório fora de localhost (QDRANT_ALLOW_INSECURE=true só conscientemente).
# QDRANT_URL=https://qdrant.exemplo.interno:6333
# QDRANT_API_KEY=
# QDRANT_TIMEOUT_MS=5000
# QDRANT_ALLOW_INSECURE=false

# --- Embeddings da pergunta (obrigatório para a busca vetorial) ---
# DEVE ser o MESMO modelo usado para indexar as coleções. Não há valor padrão.
# Provedor disponível: ollama (local, /api/embed). Instale o modelo com "ollama pull <modelo>".
# EMBEDDINGS_MODEL=
# EMBEDDINGS_PROVIDER=ollama
# EMBEDDINGS_BASE_URL=http://127.0.0.1:11434
# Dimensão esperada (validada contra a resposta e as coleções). 0 = não validar.
# EMBEDDINGS_DIMENSIONS=0
# Prefixo exigido por alguns modelos em consultas (ex.: "query: "). Vazio = nenhum.
# EMBEDDINGS_QUERY_PREFIX=
# EMBEDDINGS_TIMEOUT_MS=10000

# --- Neo4j (sessões de LEITURA; só consultas pré-autorizadas do mapeamento) ---
# bolt+s:// ou neo4j+s:// (TLS) obrigatório fora de localhost. Use um usuário com papel SÓ de leitura.
# NEO4J_URI=neo4j+s://neo4j.exemplo.interno:7687
# NEO4J_USER=
# NEO4J_PASSWORD=
# NEO4J_DATABASE=
# NEO4J_TIMEOUT_MS=5000
# NEO4J_MAX_POOL_SIZE=10
# NEO4J_ALLOW_INSECURE=false

# --- Autorização (identidade, organização e permissões vindas do Gerpro) ---
# none      = nenhuma consulta corporativa (padrão seguro enquanto a integração não existir).
# jwt-hs256 = o backend do Gerpro emite um token curto, assinado com o segredo abaixo, que o
#             widget envia em "Authorization: Bearer". Filtros enviados pelo navegador são ignorados.
# GERPRO_AUTH_MODE=none
# GERPRO_AUTH_JWT_SECRET=          # mínimo 32 bytes, compartilhado só entre os dois backends
# GERPRO_AUTH_JWT_ISSUER=
# GERPRO_AUTH_JWT_AUDIENCE=
# GERPRO_AUTH_MAX_TTL_SECONDS=900
# GERPRO_AUTH_CLOCK_SKEW_SECONDS=30
# Nomes das claims (padrões: sub, org, perms)
# GERPRO_AUTH_CLAIM_USER=sub
# GERPRO_AUTH_CLAIM_ORG=org
# GERPRO_AUTH_CLAIM_PERMISSIONS=perms
